PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8787
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub account IDs, not usernames.
ADMIN_GITHUB_IDS=
DATA_DIR=./data
# Required in production. Leave empty only for the existing local SQLite world.
DATABASE_URL=
# Docker Compose database password; choose a strong URL-safe value.
POSTGRES_PASSWORD=
NODE_ENV=development
# Optional local-only native YSM avatar override (requires JDK 21+).
DEV_AVATAR_FILE=
DEV_AVATAR_HIDE=
